# Template of environment variables for this project.
# Copy to .env.local and fill in real values:  cp .env.example .env.local
# On production set these in Vercel → Settings → Environment Variables.

# --- Supabase (orders + schedule storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AllPay (payments) ---
ALLPAY_TERMINAL_ID=
ALLPAY_API_KEY=
ALLPAY_WEBHOOK_SECRET=
# Base URL of the app (used for success/webhook URLs). Locally usually http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Public production origin. Production must use https://ryba-kiva.com for both values.
CANONICAL_SITE_URL=http://localhost:3000
# Optional defaults
DEFAULT_TICKET_PRICE_ILS=
DEFAULT_TICKET_NAME=

# --- Email ---
# Use gmail in production to send tickets from the theatre Gmail account.
EMAIL_PROVIDER=gmail
GMAIL_USER=tickets.rybakiva@gmail.com
# Create an App Password in the Google account; never commit the real value.
GMAIL_APP_PASSWORD=
EMAIL_FROM=tickets.rybakiva@gmail.com
EMAIL_FROM_NAME=Театр «Рыба Кива»
EMAIL_REPLY_TO=tickets.rybakiva@gmail.com
# Used only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# --- Admin (schedule + tickets) ---
ADMIN_SCHEDULE_LOGIN=
ADMIN_SCHEDULE_PASSWORD=

# --- Google Sheets (per-event order log via Apps Script) ---
# See docs/google-sheets-orders-setup.md
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
